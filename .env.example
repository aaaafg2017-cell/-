# Express API listen port (default: 3001)
PORT=3001

# Bind address (default: 0.0.0.0)
HOST=0.0.0.0

# JSON notes file. Default is server/data/notes.json
# NOTES_DATA_FILE=/absolute/or/relative/path/to/notes.json

# Vite proxy target for /api during `npm run dev:client`
VITE_API_TARGET=http://127.0.0.1:3001
